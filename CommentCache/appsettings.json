{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Redis": {
    "ConnectionString": "localhost:6379"
  },  
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "Username": "article_user",
    "Password": "article_password",
    "Exchange": "article.events",
    "Queue": "article.published",
    "RoutingKey": "article.published"
  },
  "Cache": {
    "MaxCachedArticles": 30,
    "TtlMinutes": 60
  }
}
