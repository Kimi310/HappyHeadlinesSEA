# Step 9 - cache-service
# Capture the AFTER numbers and compare with step 4.

@cache = http://localhost:8086

### Get stats (AFTER)
GET {{cache}}/api/cache/stats
Accept: application/json

# What to look for (cache was ON):
#   "dbQueries"        ~= 0           (reads served from cache, not SQL)
#   "dbQueriesAvoided" ~= number of reads you sent in step 8
#   "layers.l1.ratio"  near 1.0       (almost all hits in L1 memory)
#   "avgLatencyMs"     lower than step 4
#   "cacheEnabled"     == true
#
# The story: same read traffic, far fewer DB queries and lower latency
# => less compute => the caching tactic is "greener" (GAF: efficiency).
